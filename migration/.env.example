# Copy this file to migration/.env (gitignored - never commit real credentials).

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET service_role key - bypasses Row Level Security, needed so this
# script can insert historical records (with their original created dates)
# and generate signed URLs while re-uploading images. NEVER expose this key
# to a browser/frontend - it only belongs here, in a local .env file used by
# a one-off Node script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The already-deployed Google Apps Script Web App URL (same one currently in
# js/storage.js's SHEET_API_URL) - this script reads the existing Sheet data
# through its GET endpoint rather than needing separate Google API credentials.
SHEET_API_URL=https://script.google.com/macros/s/AKfycbwC-DLBpegMQiMW9TYDLLsfpyQiCyBxMDIeUAOgM-yyEsWY95vCikJFe3Z351R6VISH/exec
